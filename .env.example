DB_HOST=localhost
DB_PORT=3306
DB_USER=relay
DB_PASSWORD=relay
DB_NAME=relay_taskqueue
MYSQL_ROOT_PASSWORD=root

PORT=8000
WORKFLOW_MAX_RETRIES=3
DEFAULT_LEASE_DURATION=30s
DEFAULT_HEARTBEAT_INTERVAL=10s
DEFAULT_POOL_INTERVAL=5s
WORKER_COUNT=3

# External Worker Protocol
RELAY_WORKER_API_ENABLED=true
RELAY_WORKER_CREDENTIALS=[{"id":"staging-worker","token":"staging-relay-secret-token","queues":["*"]}]
WORKER_LONG_POLL_TIMEOUT=25s
